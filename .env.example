# OwnerRez API (Personal Access Token)
# Settings > Advanced Tools > Developer/API Settings → token pt_...
OWNERREZ_EMAIL=tu-email@ownerrez.com
OWNERREZ_TOKEN=pt_xxxxxxxx

# Panel admin
ADMIN_PASSWORD=stay4days-admin

# Chatbot IA (opcional). Sin clave usa respuestas inteligentes locales.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Emails (Resend). Sin RESEND_API_KEY la web sigue funcionando, pero no envía correos.
# https://resend.com → API Keys. Para producción verifica un dominio y usa EMAIL_FROM con ese dominio.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Stay4Days <onboarding@resend.dev>"
# Destinatario del formulario de contacto
CONTACT_EMAIL=nati2525@hotmail.com
# Opcional: avisos de reserva/pago (si no se define, usa CONTACT_EMAIL)
EMAIL_TO=
NEXT_PUBLIC_SITE_URL=https://stay4days.vercel.app
